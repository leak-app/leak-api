DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
JWT_SECRET="$(openssl rand -hex 32)"
JWT_ACCESS_TTL="60m"
JWT_REFRESH_TTL="30d"
GOOGLE_AUTH_CLIENT_ID="<YOUR_GOOGLE_AUTH_CLIENT_ID_HERE>"
GOOGLE_AUTH_CLIENT_SECRET="<YOUR_GOOGLE_AUTH_CLIENT_SECRET_HERE>"
CORS_ORIGINS="http://localhost:5173"

# Mailer & SMTP Configuration
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="LEAK App <no-reply@leak.vn>"
FRONTEND_URL="http://localhost:5173"

# Google Sheets sync (per-user export). Reuses GOOGLE_AUTH_CLIENT_ID / GOOGLE_AUTH_CLIENT_SECRET above.
# Must be registered as an Authorized redirect URI on that OAuth client. The API serves under /api.
GOOGLE_SHEETS_REDIRECT_URI="http://localhost:3000/api/sync/google-sheets/callback"
# 32 random bytes, base64. Generate with: openssl rand -base64 32
SYNC_TOKEN_ENCRYPTION_KEY=""

# Quick-log Gemini fallback (optional). Leave GEMINI_API_KEY empty to keep it off.
# Use a key from a Google Cloud project with billing enabled: unpaid Gemini API
# terms allow Google to use prompts to improve its products.
GEMINI_API_KEY=""
# No default on purpose, so a retired model id cannot hide in the code.
GEMINI_MODEL=""
GEMINI_TIMEOUT_MS="3000"
GEMINI_CALLS_PER_MINUTE="10"
