generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // Will store a hashed password
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions               Session[]
  accounts               Account[]
  categories             Category[]
  transactions           Transaction[]
  goals                  Goal[]
  goalContributions      GoalContribution[]
  budgets                Budget[]
  resetTokens            PasswordResetToken[]
  leakReclaims           LeakReclaim[]
  valuations             AccountValuation[]
  transfers              Transfer[]
  googleSheetsConnection GoogleSheetsConnection?
  syncRuns               SyncRun[]

  @@map("users")
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

enum AccountType {
  LIQUID
  INVESTMENT
}

model Account {
  id             String      @id @default(cuid())
  name           String
  type           AccountType
  initialBalance Decimal     @map("initial_balance") @db.Decimal(12, 2)
  currentBalance Decimal     @map("current_balance") @db.Decimal(12, 2)
  userId         String      @map("user_id")
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDeleted      Boolean     @default(false) @map("is_deleted")
  deletedAt      DateTime?   @map("deleted_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  transactions      Transaction[]
  goalContributions GoalContribution[]
  valuations        AccountValuation[]
  transfersOut      Transfer[]         @relation("TransferFrom")
  transfersIn       Transfer[]         @relation("TransferTo")

  @@index([userId, isDeleted])
  @@map("accounts")
}

enum ValuationKind {
  BASELINE // First update of a wallet: the difference is capital, not profit
  UPDATE // The difference is profit or loss
}

/// A balance the user entered for an investment wallet. Append-only; only the
/// latest one of a wallet can be soft-deleted.
model AccountValuation {
  id              String        @id @default(cuid())
  accountId       String        @map("account_id")
  account         Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  userId          String        @map("user_id")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            ValuationKind
  valuedAt        DateTime      @map("valued_at") @db.Date
  previousBalance Decimal       @map("previous_balance") @db.Decimal(12, 2) // last update's balance, or the opening balance
  netFlow         Decimal       @map("net_flow") @db.Decimal(12, 2) // wallet balance before this update − previousBalance
  balance         Decimal       @db.Decimal(12, 2) // what the user entered
  gain            Decimal       @db.Decimal(12, 2) // balance − previousBalance − netFlow; 0 for BASELINE
  adjustment      Decimal       @db.Decimal(12, 2) // balance − wallet balance before this update; what the ledger applied
  isDeleted       Boolean       @default(false) @map("is_deleted")
  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([accountId, isDeleted, createdAt])
  @@index([userId, valuedAt])
  @@map("account_valuations")
}

/// Money moved between two of the user's wallets. Not income or expense, so it
/// never reaches budgets, leak rate or the transaction list.
model Transfer {
  id            String    @id @default(cuid())
  fromAccountId String    @map("from_account_id")
  from          Account   @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccountId   String    @map("to_account_id")
  to            Account   @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Decimal   @db.Decimal(12, 2) // always positive
  note          String?
  occurredAt    DateTime  @map("occurred_at") @db.Date
  isDeleted     Boolean   @default(false) @map("is_deleted")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId, isDeleted, occurredAt])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("transfers")
}

enum CategoryType {
  INCOME
  EXPENSE
  INVESTMENT
}

model Category {
  id        String       @id @default(cuid())
  name      String
  emoji     String?
  type      CategoryType
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDeleted Boolean      @default(false) @map("is_deleted")
  deletedAt DateTime?    @map("deleted_at")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  transactions Transaction[]
  budgets      Budget[]

  @@map("categories")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum SpendOutcome {
  UNREVIEWED // Needs reflection (default)
  WORTH_IT // Brought joy, utility or fulfilled a core need
  NEUTRAL // Regular, unavoidable maintenance expense
  LEAK // Regretted, impulsive or wasted
}

enum LeakReason {
  IMPULSIVE
  UNUSED
  OVERPRICED
  SOCIAL_PRESSURE
  FORGOTTEN_SUB
  OTHER
}

model Transaction {
  id          String          @id @default(cuid())
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  description String? // Nullable from day one to support Phase 2 AI parsing
  categoryId  String          @map("category_id")
  category    Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  accountId   String          @map("account_id")
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  userId      String          @map("user_id")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDeleted   Boolean         @default(false) @map("is_deleted")
  deletedAt   DateTime?       @map("deleted_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  outcome     SpendOutcome    @default(UNREVIEWED)
  leakReason  LeakReason?     @map("leak_reason")
  reviewedAt  DateTime?       @map("reviewed_at")

  @@index([userId, outcome, createdAt])
  @@index([userId, isDeleted, createdAt])
  @@index([accountId])
  @@map("transactions")
}

enum GoalContributionType {
  OPENING
  DEPOSIT
  WITHDRAWAL
}

enum GoalContributionSource {
  MANUAL
  LEAK_RECLAIM
}

model Goal {
  id            String             @id @default(cuid())
  name          String
  emoji         String?
  targetAmount  Decimal            @map("target_amount") @db.Decimal(12, 2)
  savedAmount   Decimal            @default(0) @map("saved_amount") @db.Decimal(12, 2)
  targetDate    DateTime?          @map("target_date") @db.Date
  userId        String             @map("user_id")
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDeleted     Boolean            @default(false) @map("is_deleted")
  deletedAt     DateTime?          @map("deleted_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  contributions GoalContribution[]

  @@index([userId, isDeleted])
  @@map("goals")
}

model GoalContribution {
  id          String                 @id @default(cuid())
  goalId      String                 @map("goal_id")
  goal        Goal                   @relation(fields: [goalId], references: [id], onDelete: Restrict)
  accountId   String?                @map("account_id") // null only for OPENING
  account     Account?               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  userId      String                 @map("user_id")
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        GoalContributionType
  source      GoalContributionSource @default(MANUAL)
  amount      Decimal                @db.Decimal(12, 2) // always positive; direction comes from type
  note        String?
  createdAt   DateTime               @default(now()) @map("created_at")
  leakReclaim LeakReclaim?

  @@index([goalId, createdAt])
  @@index([accountId])
  @@map("goal_contributions")
}

enum LeakReclaimStatus {
  TRANSFERRED
  DISMISSED
}

model LeakReclaim {
  id             String            @id @default(cuid())
  userId         String            @map("user_id")
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  year           Int
  month          Int // 1–12, the reclaimed month
  computedAmount Decimal           @map("computed_amount") @db.Decimal(12, 2)
  transferAmount Decimal?          @map("transfer_amount") @db.Decimal(12, 2)
  status         LeakReclaimStatus
  contributionId String?           @unique @map("contribution_id")
  contribution   GoalContribution? @relation(fields: [contributionId], references: [id], onDelete: Restrict)
  createdAt      DateTime          @default(now()) @map("created_at")

  @@unique([userId, year, month])
  @@map("leak_reclaims")
}

model Budget {
  id         String   @id @default(cuid())
  amount     Decimal  @db.Decimal(12, 2)
  month      Int
  year       Int
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, categoryId, month, year])
  @@map("budgets")
}

model GoogleSheetsConnection {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEmail     String   @map("google_email")
  refreshTokenEnc String   @map("refresh_token_enc") // AES-256-GCM, never returned by any endpoint
  spreadsheetId   String   @map("spreadsheet_id")
  syncEnabled     Boolean  @default(true) @map("sync_enabled")
  needsReconnect  Boolean  @default(false) @map("needs_reconnect")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([syncEnabled, needsReconnect])
  @@map("google_sheets_connections")
}

enum SyncTrigger {
  CRON
  MANUAL
  CONNECT
}

enum SyncRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

model SyncRun {
  id               String        @id @default(cuid())
  userId           String        @map("user_id")
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trigger          SyncTrigger
  status           SyncRunStatus
  transactionCount Int           @default(0) @map("transaction_count")
  errorMessage     String?       @map("error_message")
  startedAt        DateTime      @default(now()) @map("started_at")
  finishedAt       DateTime?     @map("finished_at")

  @@index([userId, startedAt])
  @@map("sync_runs")
}
